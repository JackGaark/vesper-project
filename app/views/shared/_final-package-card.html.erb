<div class="package-card text-center">
  <div class="package-title"><h2><%= @squad.package&.name || 'No package selected' %></h2></div>
  <% if @squad.package %>
    <div class="package-price"><h4>$<%= @squad.package.price %></h4></div>
    <p><%= @squad.package.description %></p>
  <% end %>
</div>
