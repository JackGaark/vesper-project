<%- if controller_name != 'sessions' %>
  <%= link_to "Log in", new_session_path(resource_name), { class: 'fancy-input' } %><br />

<% end -%>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <a class="fancy-input" href="<%= new_registration_path(resource_name) %>">Sign up</a>
<% end -%>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <a class="fancy-input" href="<%= new_password_path(resource_name) %>">Forgot your password?</a>
<% end -%>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), { class: 'fancy-input' } %><br />
<% end -%>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), { class: 'fancy-input' } %><br />
<% end -%>

<% if devise_mapping.omniauthable? && ENV['FB_ID'].present? && ENV['FB_SECRET'].present? %>
  <%= button_to 'Sign in with Facebook', user_facebook_omniauth_authorize_path, method: :post %>
<% end %>
